{
  "manifest_version": 3,
  "name": "FlowTrace",
  "version": "0.1.0",
  "description": "Capture the tab you're on — and why you opened it — into a FlowTrace work thread.",
  "permissions": ["tabs", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": { "default_popup": "popup.html", "default_title": "Capture to FlowTrace" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "mac": "Command+Shift+U" },
      "description": "Capture the current tab"
    }
  }
}
