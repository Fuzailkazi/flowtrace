{
  "manifest_version": 3,
  "name": "FlowTrace",
  "version": "0.1.0",
  "description": "Capture the tab you're on — and why you opened it — into a FlowTrace work thread.",
  "permissions": ["tabs", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture to FlowTrace",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "mac": "Command+Shift+U" },
      "description": "Capture the current tab"
    }
  }
}
